*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# txt files
*.txt

.project
.classpath
.settings
.vscode/

# Eclipse workspace metadata (nunca debe subir al repo)
.metadata/


mvnw*
.claude/
*.png
*.svg

